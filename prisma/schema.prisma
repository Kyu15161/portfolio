generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Photo {
  id               String    @id @default(cuid())
  title            String
  description      String?
  url              String
  dominantColor    String?   @default("#c85a32")
  order            Int       @default(0)
  isFeatured       Boolean   @default(false)
  isHidden         Boolean   @default(false)
  exifCamera       String?
  exifLens         String?
  exifFocalLength  String?
  exifAperture     String?
  exifShutterSpeed String?
  exifIso          String?
  categoryId       String?
  category         Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Category {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  order     Int      @default(0)
  photos    Photo[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteConfig {
  id        String   @id @default("default")
  title     String   @default("Maren Lindqvist")
  tagline   String   @default("Color & Architectural Photographs")
  aboutText String   @default("I photograph coastal harbors and twilight transit corridors on medium-format color negative film.")
  email     String   @default("studio@marenlindqvist.se")
  instagram String?  @default("https://instagram.com")
  twitter   String?  @default("https://twitter.com")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
